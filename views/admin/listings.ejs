<% layout('/layouts/boilerplate') -%>
  <style>
    .admin-nav {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin: 1.5rem 0;
    }

    .admin-nav a {
      padding: 8px 20px;
      border-radius: 10px;
      border: 1.5px solid #e3e5ec;
      text-decoration: none;
      font-size: 0.88rem;
      font-weight: 600;
      color: #374151;
      transition: all 0.15s;
    }

    .admin-nav a:hover,
    .admin-nav a.active {
      background: var(--primary);
      color: #fff;
      border-color: var(--primary);
      text-decoration: none;
    }

    .table-card {
      background: #fff;
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.88rem;
    }

    thead th {
      padding: 8px 12px;
      text-align: left;
      font-size: 0.78rem;
      color: #6b7280;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      border-bottom: 1px solid #f1f5f9;
    }

    tbody td {
      padding: 10px 12px;
      border-bottom: 1px solid #f9fafb;
      color: #374151;
    }

    tbody tr:hover td {
      background: #fafafa;
    }

    .btn-del {
      background: none;
      border: 1.5px solid #fca5a5;
      border-radius: 8px;
      color: #ef4444;
      padding: 4px 12px;
      cursor: pointer;
      font-size: 0.8rem;
      font-weight: 600;
      transition: all 0.15s;
    }

    .btn-del:hover {
      background: #ef4444;
      color: #fff;
    }

    .thumb {
      width: 48px;
      height: 38px;
      border-radius: 8px;
      object-fit: cover;
    }
    .user-tabs { display: flex; gap: 6px; margin-bottom: 1rem; }
    .user-tab {
      padding: 6px 16px; border-radius: 999px; border: 1.5px solid #e3e5ec; background: #fff;
      font-size: 0.85rem; font-weight: 600; color: #374151; cursor: pointer; font-family: inherit;
    }
    .user-tab.active { background: #1f2933; border-color: #1f2933; color: #fff; }
    .user-tab .count { opacity: 0.7; margin-left: 4px; }
    .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 0.75rem; font-weight: 700; }
    .badge-owner-del { background: #eff6ff; color: #1d4ed8; }
    .badge-removed { background: #fef2f2; color: #b91c1c; }
    .v-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 10px; border-radius: 999px; font-size: 0.74rem; font-weight: 700; white-space: nowrap; }
    .v-verified { background: #ecfdf5; color: #047857; }
    .v-pending { background: #f3f4f6; color: #4b5563; }
    .v-rejected { background: #fef2f2; color: #b91c1c; }
    .queue-card { border: 1.5px solid #fde68a; margin-bottom: 1.5rem; }
    .queue-card h3 { font-size: 1.05rem; font-weight: 700; margin-bottom: 0.3rem; color: #92400e; }
    .queue-actions { display: flex; flex-direction: column; gap: 6px; min-width: 220px; }
    .queue-actions input { border: 1.5px solid #e3e5ec; border-radius: 8px; padding: 5px 8px; font-size: 0.8rem; font-family: inherit; width: 100%; }
    .btn-verify { background: #047857; color: #fff; border: none; border-radius: 8px; padding: 5px 12px; font-size: 0.8rem; font-weight: 600; cursor: pointer; }
    .btn-verify:hover { background: #065f46; }
    .btn-soft { background: none; border: 1.5px solid #e3e5ec; border-radius: 8px; color: #374151; padding: 4px 12px; font-size: 0.8rem; font-weight: 600; cursor: pointer; }
    .btn-soft:hover { border-color: #9ca3af; }
  </style>

  <h2 style="font-size:1.6rem;font-weight:700;margin:1.5rem 0 0.5rem;">Listings Management</h2>
  <div class="admin-nav">
    <a href="/admin/dashboard">Dashboard</a>
    <a href="/admin/users">Users</a>
    <a href="/admin/listings" class="active">Listings</a>
    <a href="/admin/bookings">Bookings</a>
  </div>

  <!-- Verification queue -->
  <div class="table-card queue-card">
    <h3><i class="fa-solid fa-clipboard-check"></i> Verification requests (<%= verificationQueue.length %>)</h3>
    <p style="font-size:0.84rem;color:#6b7280;margin-bottom:1rem;">
      Verify only after checking the property (ground visit, documents or video call). Oldest requests first.
    </p>
    <% if (verificationQueue.length === 0) { %>
      <p style="color:#9ca3af;font-style:italic;font-size:0.9rem;margin:0;">No listings waiting for verification.</p>
    <% } else { %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr><th>Listing</th><th>Owner</th><th>Requested</th><th>Note</th><th>Decision</th></tr>
        </thead>
        <tbody>
          <% verificationQueue.forEach(l => { %>
            <tr>
              <td>
                <a href="/listings/<%= l._id %>" target="_blank" style="font-weight:600;color:#1f2933;"><%= l.title %></a>
                <div style="font-size:0.78rem;color:#6b7280;"><%= l.location %>, <%= l.country %> · ₹<%= l.price?.toLocaleString('en-IN') %>/night</div>
              </td>
              <td>
                <%= l.owner?.username || '—' %>
                <div style="font-size:0.75rem;color:#9ca3af;"><%= l.owner?.email || '' %></div>
              </td>
              <td style="white-space:nowrap;"><%= requestedAt(l).toLocaleDateString('en-IN') %></td>
              <td style="max-width:200px;font-size:0.8rem;color:#6b7280;"><%= l.verification?.note || '—' %></td>
              <td>
                <div class="queue-actions">
                  <form method="POST" action="/admin/listings/<%= l._id %>/verify" style="display:flex;gap:6px;">
                    <input type="text" name="note" maxlength="500" placeholder="Note (e.g. visited 24 Oct)">
                    <button type="submit" class="btn-verify"><i class="fa-solid fa-check"></i> Verify</button>
                  </form>
                  <form method="POST" action="/admin/listings/<%= l._id %>/reject" style="display:flex;gap:6px;">
                    <input type="text" name="note" maxlength="500" placeholder="Reason (required)" required>
                    <button type="submit" class="btn-soft">Reject</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <div class="user-tabs" role="tablist">
    <button type="button" class="user-tab active" data-tab="active" role="tab">Active<span class="count">(<%= listings.length %>)</span></button>
    <button type="button" class="user-tab" data-tab="deleted" role="tab">Deleted<span class="count">(<%= deletedListings.length %>)</span></button>
  </div>

  <div class="table-card" data-panel="active">
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Image</th>
            <th>Title</th>
            <th>Location</th>
            <th>Price</th>
            <th>Owner</th>
            <th>Verification</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% listings.forEach((l, i)=> { %>
            <tr>
              <td style="color:#9ca3af;">
                <%= i+1 %>
              </td>
              <td><img src="<%= l.image?.url || l.image || '/images/placeholder.jpg' %>" class="thumb"
                  onerror="this.src='/images/placeholder.jpg'"></td>
              <td><a href="/listings/<%= l._id %>" style="font-weight:600;color:#1f2933;">
                  <%= l.title %>
                </a></td>
              <td style="color:#6b7280;">
                <%= l.location %>, <%= l.country %>
              </td>
              <td><strong>₹<%= l.price?.toLocaleString('en-IN') %></strong></td>
              <td>
                <%= l.owner?.username %>
              </td>
              <td>
                <% const vs = statusOf(l); %>
                <% if (vs === 'verified') { %>
                  <span class="v-badge v-verified" title="<%= l.verification?.note || '' %>"><i class="fa-solid fa-circle-check"></i> Verified</span>
                  <div style="font-size:0.72rem;color:#9ca3af;margin-top:2px;">
                    by <%= l.verification?.reviewedBy?.username || 'admin' %><% if (l.verification?.reviewedAt) { %>, <%= new Date(l.verification.reviewedAt).toLocaleDateString('en-IN') %><% } %>
                  </div>
                  <form method="POST" action="/admin/listings/<%= l._id %>/revoke" style="margin-top:4px;"
                    onsubmit="return confirm('Remove the Verified badge and send this listing back to the queue?');">
                    <button type="submit" class="btn-soft" style="font-size:0.72rem;padding:2px 8px;">Revoke</button>
                  </form>
                <% } else if (vs === 'rejected') { %>
                  <span class="v-badge v-rejected" title="<%= l.verification?.note || '' %>"><i class="fa-solid fa-circle-xmark"></i> Rejected</span>
                  <div style="font-size:0.72rem;color:#9ca3af;margin-top:2px;max-width:180px;"><%= l.verification?.note || '' %></div>
                <% } else { %>
                  <span class="v-badge v-pending"><i class="fa-regular fa-clock"></i> Pending</span>
                <% } %>
              </td>
              <td>
                <form method="POST" action="/admin/listings/<%= l._id %>?_method=DELETE"
                  onsubmit="return confirm('Delete this listing?');">
                  <button type="submit" class="btn-del">Delete</button>
                </form>
              </td>
            </tr>
            <% }) %>
        </tbody>
      </table>
    </div>

  </div>

  <div class="table-card" data-panel="deleted" hidden>
    <% if (deletedListings.length === 0) { %>
      <p style="color:#9ca3af;font-style:italic;font-size:0.9rem;margin:0;">No deleted listings yet.</p>
    <% } else { %>
    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Title</th>
            <th>Location</th>
            <th>Price</th>
            <th>Owner</th>
            <th>Created</th>
            <th>Deleted</th>
            <th>How</th>
            <th>Activity</th>
          </tr>
        </thead>
        <tbody>
          <% deletedListings.forEach((d, i) => { %>
            <tr>
              <td style="color:#9ca3af;"><%= i+1 %></td>
              <td><strong><%= d.title %></strong></td>
              <td style="color:#6b7280;"><%= [d.location, d.country].filter(Boolean).join(', ') || '—' %></td>
              <td>₹<%= d.price?.toLocaleString('en-IN') ?? '—' %></td>
              <td>
                <%= d.owner?.username || '—' %>
                <% if (d.owner?.email) { %><div style="font-size:0.75rem;color:#9ca3af;"><%= d.owner.email %></div><% } %>
              </td>
              <td><%= d.createdAt ? new Date(d.createdAt).toLocaleDateString('en-IN') : '—' %></td>
              <td><%= new Date(d.deletedAt).toLocaleDateString('en-IN') %></td>
              <td>
                <% if (d.method === 'owner') { %>
                  <span class="badge badge-owner-del">By owner</span>
                <% } else { %>
                  <span class="badge badge-removed">Removed by admin</span>
                <% } %>
                <div style="font-size:0.75rem;color:#9ca3af;margin-top:2px;">by <%= d.deletedBy?.username || '—' %></div>
              </td>
              <td style="font-size:0.8rem;color:#6b7280;">
                <%= d.totalBookings %> booking(s)<br>
                <%= d.totalReviews %> review(s)<% if (d.totalReviews > 0 && d.avgRating) { %> · ★ <%= d.avgRating.toFixed(1) %><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <script>
    document.querySelectorAll('.user-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.user-tab').forEach(t => t.classList.toggle('active', t === tab));
        document.querySelectorAll('[data-panel]').forEach(p => { p.hidden = p.dataset.panel !== tab.dataset.tab; });
      });
    });
  </script>
