<% if (success && success.length > 0) { %>
  <div class="hk-flash hk-flash-success" role="status">
    <i class="fa-solid fa-circle-check"></i>
    <span><%= success[0] %></span>
    <button type="button" class="hk-flash-close" aria-label="Dismiss message">&times;</button>
  </div>
<% } %>

<% if (error && error.length > 0) { %>
  <div class="hk-flash hk-flash-error" role="alert">
    <i class="fa-solid fa-circle-exclamation"></i>
    <span><%= error[0] %></span>
    <button type="button" class="hk-flash-close" aria-label="Dismiss message">&times;</button>
  </div>
<% } %>

<script>
  (() => {
    const dismiss = (el) => {
      if (!el || el.classList.contains('is-hiding')) return;
      el.classList.add('is-hiding');
      setTimeout(() => el.remove(), 200);
    };
    // Close on ×
    document.querySelectorAll('.hk-flash-close').forEach(btn =>
      btn.addEventListener('click', () => dismiss(btn.closest('.hk-flash')))
    );
    // Auto-dismiss after 4s
    document.querySelectorAll('.hk-flash').forEach(el => setTimeout(() => dismiss(el), 4000));
  })();
</script>
