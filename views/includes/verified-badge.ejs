<%#
  Verified / Not verified badge for a listing.
  Usage: include('../includes/verified-badge', { listing, size: 'sm' | 'md' })
  Listings created before verification existed have no status → "Not verified".
%>
<% const isVerified = listing && listing.verification && listing.verification.status === 'verified'; %>
<% const big = typeof size !== 'undefined' && size === 'md'; %>
<span class="hk-verify-badge <%= isVerified ? 'is-verified' : 'is-unverified' %> <%= big ? 'is-md' : '' %>"
  title="<%= isVerified ? 'Checked by the Homekuti team' : 'Not yet checked by the Homekuti team' %>">
  <i class="fa-solid <%= isVerified ? 'fa-circle-check' : 'fa-circle-question' %>"></i>
  <%= isVerified ? 'Verified' : 'Not verified' %>
</span>
