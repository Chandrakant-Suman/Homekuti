<% layout('/layouts/boilerplate') -%>

<style>
  .signin-wrapper { min-height: calc(100vh - 72px); display: flex; align-items: center; justify-content: center;
    background: radial-gradient(circle at top, #ffffff 0%, #f5f4f8 55%, #f1f5f9 100%); padding: 2rem 1rem; }
  .signin-card { background: #fff; border-radius: 20px; padding: 2.5rem 2.2rem; width: 100%; max-width: 480px;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08); }
  .signin-title { font-size: 1.8rem; font-weight: 700; text-align: center; color: #1f2933; margin-bottom: 0.6rem; }
  .signin-sub { text-align: center; color: #6b7280; font-size: 0.92rem; margin-bottom: 1.8rem; }
  .signin-label { font-size: 0.9rem; font-weight: 600; color: #374151; margin-bottom: 6px; display: block; }
  .signin-input { width: 100%; border: 1.5px solid #e3e5ec; border-radius: 10px; padding: 12px 16px; font-size: 0.95rem;
    font-family: inherit; color: #1f2933; background: #fff; outline: none; transition: border-color 0.2s; box-sizing: border-box; }
  .signin-input:focus { border-color: var(--primary); }
  .mb-form { margin-bottom: 1.2rem; }
  .signin-hint { font-size: 0.78rem; color: #9ca3af; margin-top: 4px; }
  .signin-btn { width: 100%; height: 50px; background: var(--primary); color: #fff; border: none; border-radius: 10px;
    font-size: 1rem; font-weight: 700; cursor: pointer; transition: background 0.2s; margin-top: 0.5rem; }
  .signin-btn:hover { background: var(--primary-dark); }
  .signin-footer { text-align: center; margin-top: 1.4rem; font-size: 0.9rem; color: #6b7280; }
  .signin-footer a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .signin-footer a:hover { text-decoration: underline; }
</style>

<div class="signin-wrapper">
  <div class="signin-card">
    <h2 class="signin-title">Forgot Password</h2>
    <p class="signin-sub">Enter the email linked to your account and we'll send you a link to reset your password.</p>

    <form action="/user/forgot-password" method="POST">
      <div class="mb-form">
        <label class="signin-label" for="email">Email</label>
        <input type="email" class="signin-input" id="email" name="email" placeholder="you@example.com" required autocomplete="email" />
      </div>
      <button type="submit" class="signin-btn">Send Reset Link</button>
    </form>

    <div class="signin-footer">
      Remembered it? <a href="/user/signin">Back to sign in</a>
    </div>
  </div>
</div>
