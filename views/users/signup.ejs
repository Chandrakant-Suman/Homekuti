<% layout('/layouts/boilerplate') -%>

<style>
  .signin-wrapper {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem 1rem;
  }
  .signin-card {
    background: #fff;
    border-radius: 20px;
    padding: 2.5rem 2.2rem;
    width: 100%;
    max-width: 480px;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
  }
  .signin-title { font-size: 2rem; font-weight: 700; text-align: center; color: #1f2933; margin-bottom: 2rem; }
  .signin-label { font-size: 0.9rem; font-weight: 600; color: #374151; margin-bottom: 6px; display: block; }
  .signin-input {
    width: 100%; border: 1.5px solid #e3e5ec; border-radius: 10px;
    padding: 12px 16px; font-size: 0.95rem; font-family: inherit;
    color: #1f2933; background: #fff; outline: none; transition: border-color 0.2s; box-sizing: border-box;
  }
  .signin-input::placeholder { color: #9ca3af; }
  .signin-input:focus { border-color: var(--primary); }
  .mb-form { margin-bottom: 1.2rem; }
  .signin-btn {
    width: 100%; height: 50px; background: var(--primary); color: #fff;
    border: none; border-radius: 10px; font-size: 1rem; font-weight: 700;
    cursor: pointer; transition: background 0.2s; margin-top: 0.5rem;
  }
  .signin-btn:hover { background: var(--primary-dark); }
  .signin-footer { text-align: center; margin-top: 1.4rem; font-size: 0.9rem; color: #6b7280; }
  .signin-footer a { color: var(--primary); font-weight: 600; text-decoration: none; }
  .su-hint { font-size: 0.78rem; color: #9ca3af; margin-top: 4px; }
  .su-hint.su-error { color: #ef4444; }
  .signin-input.is-invalid { border-color: #ef4444; }
</style>

<div class="signin-wrapper">
  <div class="signin-card">
    <h2 class="signin-title">Create Account</h2>

    <% const v = (typeof values !== 'undefined' && values) || {}; const e = (typeof errors !== 'undefined' && errors) || {}; %>
    <form action="/user/signup" method="POST" novalidate>
      <div class="mb-form">
        <label class="signin-label" for="su-username">Username</label>
        <input type="text" id="su-username" class="signin-input <%= e.username ? 'is-invalid' : '' %>" name="username"
          placeholder="Choose a username" value="<%= v.username || '' %>" required minlength="3" maxlength="30"
          pattern="[A-Za-z0-9_.]{3,30}" autocomplete="username" />
        <div class="su-hint <%= e.username ? 'su-error' : '' %>"><%= e.username || 'Letters, numbers, dots or underscores (3–30).' %></div>
      </div>
      <div class="mb-form">
        <label class="signin-label" for="su-email">Email</label>
        <input type="email" id="su-email" class="signin-input <%= e.email ? 'is-invalid' : '' %>" name="email"
          placeholder="Enter your email" value="<%= v.email || '' %>" required maxlength="254" autocomplete="email" />
        <div class="su-hint <%= e.email ? 'su-error' : '' %>"><%= e.email || "We'll send a link to verify it." %></div>
      </div>
      <div class="mb-form">
        <label class="signin-label" for="su-password">Password</label>
        <input type="password" id="su-password" class="signin-input <%= e.password ? 'is-invalid' : '' %>" name="password"
          placeholder="Create a password" required minlength="8" maxlength="128" autocomplete="new-password" />
        <div class="su-hint <%= e.password ? 'su-error' : '' %>"><%= e.password || 'At least 8 characters, with a letter and a number.' %></div>
      </div>
      <button type="submit" class="signin-btn">Create Account</button>
    </form>

    <div class="signin-footer">
      Already have an account? <a href="/user/signin">Sign in</a>
    </div>
  </div>
</div>
