<% layout('/layouts/boilerplate') -%>

<style>
  .profile-layout { display: grid; grid-template-columns: 280px 1fr; gap: 2rem; margin-top: 2rem; }
  @media (max-width: 768px) { .profile-layout { grid-template-columns: 1fr; } }

  .profile-sidebar {
    background: #fff; border-radius: 20px; padding: 2rem;
    box-shadow: 0 8px 30px rgba(15,23,42,0.07); text-align: center; height: fit-content;
  }
  .profile-avatar {
    width: 80px; height: 80px; border-radius: 50%;
    background: var(--primary); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 2rem; font-weight: 700; margin: 0 auto 1rem;
  }
  .profile-name { font-size: 1.2rem; font-weight: 700; color: #1f2933; margin-bottom: 4px; }
  .profile-email { font-size: 0.85rem; color: #6b7280; margin-bottom: 1rem; }
  .profile-role { display: inline-block; padding: 4px 14px; border-radius: 999px; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 1.2rem; }
  .role-user { background: #eff6ff; color: #1d4ed8; }
  .role-owner { background: #f0fdf4; color: #15803d; }
  .role-admin { background: #fef3c7; color: #92400e; }
  .profile-stat { display: flex; justify-content: space-around; border-top: 1px solid #f1f5f9; padding-top: 1rem; margin-top: 0.5rem; }
  .stat-item { text-align: center; }
  .stat-num { font-size: 1.4rem; font-weight: 700; color: #1f2933; }
  .stat-label { font-size: 0.78rem; color: #6b7280; }

  .profile-main { display: flex; flex-direction: column; gap: 1.5rem; }
  .section-card { background: #fff; border-radius: 20px; padding: 1.8rem; box-shadow: 0 8px 30px rgba(15,23,42,0.07); }
  .section-card h3 { font-size: 1.1rem; font-weight: 700; color: #1f2933; margin-bottom: 1.2rem; display: flex; align-items: center; gap: 8px; }

  .wishlist-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 1rem; }
  .wishlist-item { border-radius: 12px; overflow: hidden; border: 1.5px solid #e3e5ec; transition: box-shadow 0.15s; text-decoration: none; color: inherit; display: block; }
  .wishlist-item:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.08); text-decoration: none; }
  .wishlist-img { width: 100%; height: 110px; object-fit: cover; }
  .wishlist-body { padding: 0.7rem; }
  .wishlist-title { font-size: 0.85rem; font-weight: 600; color: #1f2933; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wishlist-price { font-size: 0.8rem; color: #6b7280; }

  .empty-msg { color: #9ca3af; font-size: 0.9rem; font-style: italic; }

  .settings-form { display: flex; flex-direction: column; gap: 0.8rem; max-width: 420px; }
  .settings-form label { font-size: 0.82rem; font-weight: 600; color: #374151; margin-bottom: 2px; display: block; }
  .settings-form input, .settings-form textarea {
    width: 100%; border: 1.5px solid #e3e5ec; border-radius: 10px; padding: 0.55rem 0.8rem;
    font-size: 0.9rem; font-family: inherit;
  }
  .settings-form input:focus, .settings-form textarea:focus { outline: none; border-color: var(--primary); }
  .settings-hint { font-size: 0.78rem; color: #9ca3af; margin-top: 2px; }
  .settings-divider { border: 0; border-top: 1px solid #f1f5f9; margin: 1.5rem 0; }
  .danger-card { border: 1.5px solid #fecaca; }
  .danger-card h3 { color: #b91c1c; }
  .hk-btn-danger { background: #fff; color: #ef4444; border: 1.5px solid #fca5a5; }
  .hk-btn-danger:hover { background: #ef4444; color: #fff; }
  .delete-status { padding: 0.8rem 1rem; border-radius: 12px; font-size: 0.88rem; margin-bottom: 1rem; }
  .delete-status.pending { background: #fef3c7; color: #92400e; }
  .delete-status.rejected { background: #fef2f2; color: #b91c1c; }
</style>

<div class="profile-layout">
  <!-- Sidebar -->
  <div class="profile-sidebar">
    <% if (user.avatar) { %>
      <img src="<%= user.avatar %>" alt="Avatar" style="width:80px;height:80px;border-radius:50%;object-fit:cover;margin:0 auto 1rem;display:block;">
    <% } else { %>
      <div class="profile-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
    <% } %>
    <div class="profile-name"><%= user.username %></div>
    <div class="profile-email"><%= user.email %></div>
    <span class="profile-role role-<%= user.role %>"><%= user.role %></span>

    <div class="profile-stat">
      <div class="stat-item">
        <div class="stat-num"><%= user.bookings?.length || 0 %></div>
        <div class="stat-label">Bookings</div>
      </div>
      <div class="stat-item">
        <div class="stat-num"><%= user.wishlist?.length || 0 %></div>
        <div class="stat-label">Saved</div>
      </div>
    </div>

    <div style="margin-top:1.5rem;display:flex;flex-direction:column;gap:8px;">
      <a href="/bookings/my" class="hk-btn" style="width:100%;text-align:center;">My Bookings</a>
      <a href="/listings/new" class="hk-btn" style="width:100%;text-align:center;background:#fff;color:var(--primary);">Add a Listing</a>
      <% if (user.role === 'admin') { %>
        <a href="/admin/dashboard" class="hk-btn" style="width:100%;text-align:center;background:#fef3c7;color:#92400e;border-color:#fcd34d;">Admin Panel</a>
      <% } %>
    </div>
  </div>

  <!-- Main content -->
  <div class="profile-main">
    <!-- Wishlist -->
    <div class="section-card">
      <h3><i class="fa-solid fa-heart" style="color:var(--primary);"></i> Saved Stays</h3>
      <% if (!user.wishlist || user.wishlist.length === 0) { %>
        <p class="empty-msg">No saved stays yet. Heart a listing to save it!</p>
      <% } else { %>
        <div class="wishlist-grid">
          <% user.wishlist.forEach(listing => { %>
            <% if (listing && listing._id) { %>
              <a href="/listings/<%= listing._id %>" class="wishlist-item">
                <img src="<%= listing.image?.url || listing.image || '/images/placeholder.jpg' %>"
                  class="wishlist-img" alt="<%= listing.title %>"
                  onerror="this.src='/images/placeholder.jpg'">
                <div class="wishlist-body">
                  <div class="wishlist-title"><%= listing.title %></div>
                  <div class="wishlist-price">₹<%= listing.price?.toLocaleString('en-IN') %>/night</div>
                </div>
              </a>
            <% } %>
          <% }) %>
        </div>
      <% } %>
    </div>

    <!-- Account info -->
    <div class="section-card">
      <h3><i class="fa-solid fa-circle-info" style="color:#6b7280;"></i> Account Info</h3>
      <div style="display:flex;flex-direction:column;gap:0.8rem;">
        <div style="display:flex;justify-content:space-between;padding:0.6rem 0;border-bottom:1px solid #f1f5f9;">
          <span style="color:#6b7280;font-size:0.9rem;">Username</span>
          <span style="font-weight:600;color:#1f2933;font-size:0.9rem;"><%= user.username %></span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:0.6rem 0;border-bottom:1px solid #f1f5f9;">
          <span style="color:#6b7280;font-size:0.9rem;">Email</span>
          <span style="font-weight:600;color:#1f2933;font-size:0.9rem;text-align:right;">
            <%= user.email %>
            <% if (user.emailVerified === false) { %>
              <span style="display:inline-block;margin-left:6px;padding:1px 8px;border-radius:999px;background:#fffbeb;color:#92400e;font-size:0.72rem;">Not verified</span>
            <% } else { %>
              <span style="display:inline-block;margin-left:6px;padding:1px 8px;border-radius:999px;background:#ecfdf5;color:#047857;font-size:0.72rem;"><i class="fa-solid fa-circle-check"></i> Verified</span>
            <% } %>
          </span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:0.6rem 0;border-bottom:1px solid #f1f5f9;">
          <span style="color:#6b7280;font-size:0.9rem;">Role</span>
          <span style="font-weight:600;color:#1f2933;font-size:0.9rem;text-transform:capitalize;"><%= user.role %></span>
        </div>
        <div style="display:flex;justify-content:space-between;padding:0.6rem 0;">
          <span style="color:#6b7280;font-size:0.9rem;">Member since</span>
          <span style="font-weight:600;color:#1f2933;font-size:0.9rem;">
            <%= new Date(user.createdAt).toLocaleDateString('en-IN', {month:'long', year:'numeric'}) %>
          </span>
        </div>
      </div>
    </div>

    <!-- Account settings -->
    <div class="section-card">
      <h3><i class="fa-solid fa-user-pen" style="color:#6b7280;"></i> Account Settings</h3>

      <form method="POST" action="/user/profile/username?_method=PATCH" class="settings-form">
        <div>
          <label for="username">Username</label>
          <input type="text" id="username" name="username" value="<%= user.username %>"
            required minlength="3" maxlength="30" pattern="[a-zA-Z0-9_.]{3,30}">
          <div class="settings-hint">3-30 characters: letters, numbers, dots or underscores.</div>
        </div>
        <div><button type="submit" class="hk-btn">Update Username</button></div>
      </form>

      <hr class="settings-divider">

      <form method="POST" action="/user/profile/password?_method=PATCH" class="settings-form" id="passwordForm">
        <% if (hasPassword) { %>
          <div>
            <label for="currentPassword">Current password</label>
            <input type="password" id="currentPassword" name="currentPassword" required autocomplete="current-password">
          </div>
        <% } else { %>
          <div class="settings-hint" style="margin:0;">You signed in with Google. Set a password to also sign in with your username.</div>
        <% } %>
        <div>
          <label for="newPassword">New password</label>
          <input type="password" id="newPassword" name="newPassword" required minlength="8" autocomplete="new-password">
          <div class="settings-hint">At least 8 characters.</div>
        </div>
        <div>
          <label for="confirmPassword">Confirm new password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" required minlength="8" autocomplete="new-password">
        </div>
        <div><button type="submit" class="hk-btn"><%= hasPassword ? 'Change Password' : 'Set Password' %></button></div>
      </form>
    </div>

    <!-- Delete account -->
    <div class="section-card danger-card">
      <h3><i class="fa-solid fa-triangle-exclamation"></i> Delete Account</h3>
      <% const delStatus = user.deleteRequest?.status || 'none'; %>

      <% if (user.role === 'admin') { %>
        <p class="empty-msg" style="font-style:normal;">Admin accounts can't request deletion. Ask another admin to change your role first.</p>
      <% } else if (delStatus === 'pending') { %>
        <div class="delete-status pending">
          Your deletion request was sent on
          <strong><%= new Date(user.deleteRequest.requestedAt).toLocaleDateString('en-IN') %></strong>
          and is awaiting admin review.
        </div>
        <form method="POST" action="/user/profile/delete-request?_method=DELETE">
          <button type="submit" class="hk-btn">Cancel Request</button>
        </form>
      <% } else { %>
        <% if (delStatus === 'rejected') { %>
          <div class="delete-status rejected">
            Your previous deletion request was declined. Please make sure you have no upcoming bookings or active listings, then try again.
          </div>
        <% } %>
        <p style="font-size:0.88rem;color:#6b7280;margin-bottom:1rem;">
          Request permanent deletion of your account. An admin will review it; any upcoming bookings or listings you own must be resolved first.
        </p>
        <form method="POST" action="/user/profile/delete-request" class="settings-form"
          onsubmit="return confirm('Send a request to permanently delete your account?');">
          <div>
            <label for="reason">Reason (optional)</label>
            <textarea id="reason" name="reason" rows="3" maxlength="500"></textarea>
          </div>
          <div><button type="submit" class="hk-btn hk-btn-danger">Request Account Deletion</button></div>
        </form>
      <% } %>
    </div>
  </div>
</div>

<script>
  // Client-side check that the two new passwords match
  document.getElementById('passwordForm')?.addEventListener('submit', (e) => {
    const np = document.getElementById('newPassword');
    const cp = document.getElementById('confirmPassword');
    if (np.value !== cp.value) {
      e.preventDefault();
      cp.setCustomValidity('Passwords do not match');
      cp.reportValidity();
    }
  });
  document.getElementById('confirmPassword')?.addEventListener('input', (e) => e.target.setCustomValidity(''));
</script>
