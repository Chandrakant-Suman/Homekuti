<% layout('/layouts/boilerplate') -%>

<main class="static-page">
  <h1>About Homekuti</h1>
  <p>
    Homekuti helps you find homestays across India — cottages, heritage homes and mountain
    retreats run by real hosts — and book them in a few clicks.
  </p>

  <div class="static-grid">
    <div class="static-card">
      <h3><i class="fa-solid fa-circle-check" style="color:#047857;"></i> Verified stays</h3>
      <p>Our team checks listings. Look for the <strong>Verified</strong> badge.</p>
    </div>
    <div class="static-card">
      <h3><i class="fa-solid fa-indian-rupee-sign" style="color:var(--primary);"></i> Clear pricing</h3>
      <p>Nightly price, extra-guest charge, GST and a flat ₹20 service fee — shown before you pay.</p>
    </div>
    <div class="static-card">
      <h3><i class="fa-solid fa-star" style="color:#d97706;"></i> Honest reviews</h3>
      <p>Only guests who completed a stay can review it.</p>
    </div>
  </div>

  <h2>For hosts</h2>
  <p>List your home for free. It goes live right away and gets the Verified badge once our team has checked it.</p>

  <p style="margin-top:1.5rem;">Questions? <a href="/contact">Get in touch</a>.</p>
</main>
