      </div>

      <!-- CARD 2 -->
      <div class="hk-testimonial-card">
        <div class="hk-user">
          <img src="/images/user2.jpg" alt="user">
          <div>
            <h4>Riya</h4>
            <div class="hk-stars">★★★★★</div>
          </div>
        </div>
        <p>"Felt like home. Would definitely recommend!"</p>
      </div>

      <!-- CARD 3 -->
      <div class="hk-testimonial-card">
        <div class="hk-user">
          <img src="/images/user3.jpg" alt="user">
          <div>
            <h4>Kabir</h4>
            <div class="hk-stars">★★★★★</div>
          </div>
        </div>
        <p>"Will book again. Great experience overall."</p>
      </div>

    </div>
  </section>