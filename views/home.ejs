  <!-- Why Choose Homekuti -->
  <section class="hk-why">
    <h2 class="hk-why-title">Why Choose Homekuti?</h2>

    <div class="hk-why-grid">

      <!-- ITEM 1 -->
      <div class="hk-why-item">
        <div class="hk-why-icon">
          <img src="/images/assign.png" alt="user" style="height: 50px; width: 65px; size: fit;">
        </div>
        <h4>Verified Hosts</h4>
        <p>Verifies your reservations and verified hosts.</p>
      </div>

      <!-- ITEM 2 -->
      <div class="hk-why-item">
        <div class="hk-why-icon">
          <img src="/images/support.png" alt="support" style="height: 50px; width: 65px; size: fit;">
        </div>
        <h4>24/7 Local Support</h4>
        <p>Based in town, ready to help anytime.</p>
      </div>

      <!-- ITEM 3 -->
      <div class="hk-why-item">
        <div class="hk-why-icon">
          <img src="/images/experience.png" alt="experience" style="height: 50px; width: 65px; size: fit;">
        </div>
        <h4>Unique Experiences</h4>
        <p>Stay somewhere that actually feels different.</p>
      </div>

    </div>
  </section>

  <!-- Testimonials -->
  <section class="hk-testimonials-section">
    <h2 class="hk-testimonials-title">Testimonials</h2>

    <div class="hk-testimonials-grid">

      <!-- CARD 1 -->
      <div class="hk-testimonial-card">
        <div class="hk-user">
          <img src="/images/user1.png" alt="user">
          <div>
            <h4>Aarav</h4>
